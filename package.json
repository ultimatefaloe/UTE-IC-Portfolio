    "animejs": "^4.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "emailjs": "^4.0.3",
    "framer-motion": "^12.42.2",
    "lucide-react": "^0.546.0",
    "next": "15.5.9",
    "prisma": "^6.16.0",
