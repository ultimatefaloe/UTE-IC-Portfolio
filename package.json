{
  "name": "portfolio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "prisma:dev:mig": "prisma migrate deploy",
    "db:dev:rm": "docker compose -f docker-compose.yml rm -s -f -v",
    "db:dev:up": "docker compose -f docker-compose.yml up -d",
    "db:dev:restart": "pnpm run db:dev:rm && pnpm run db:dev:up && sleep 2 && pnpm run prisma:dev:mig",
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "db:seed": "prisma db seed"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
